{
  "name": "qaq-revival",
  "version": "1.1.4",
  "private": true,
  "license": "MIT",
  "description": "QAQ-Revival — locally maintained Arknights Mod manager",
  "scripts": {
    "build": "node tools/build.cjs",
    "build:components": "node tools/build-components.cjs",
    "update:components": "node tools/update-components.cjs",
    "update:characters": "node tools/update-character-catalogs.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:unit": "node --test tests/*.test.cjs",
    "test:single-instance": "node --test tests/single-instance.test.cjs",
    "test:random-launch": "node --test tests/random-executable.test.cjs tests/single-instance.test.cjs tests/windows-launch.test.cjs",
    "test:translation": "node --test tests/hotkey-translation.test.cjs",
    "test:hidden-characters": "node --test tests/hidden-characters.test.cjs",
    "test:character-images": "node --test tests/character-image-cache.test.cjs",
    "test:persist": "node --test tests/persist-settings.test.cjs",
    "test:overlay-activity": "node --test tests/overlay-activity.test.cjs",
    "test:interaction": "node --test tests/global-shortcuts.test.cjs tests/mod-order.test.cjs tests/navigation.test.cjs",
    "build:mega": "node tools/build-mega.cjs",
    "build:key-helper": "node tools/build-key-helper.cjs",
    "test:key-helper": "node tools/build-key-helper.cjs --test",
    "build:app": "node tools/build-app.cjs",
    "dev:renderer": "vite --config vite.config.mjs",
    "check:i18n": "node tools/check-i18n.cjs",
    "lint": "eslint app/src",
    "check": "npm run lint && npm run check:i18n",
    "format": "prettier --write app/src",
    "sync:upstreams": "node tools/sync-upstreams.cjs"
  },
  "productName": "QAQ-Revival",
  "devDependencies": {
    "@babel/parser": "8.0.8",
    "@babel/traverse": "8.0.7",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
